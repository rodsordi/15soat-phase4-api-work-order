<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.fiap.phase4</groupId>
        <artifactId>15soat-phase4-api-work-order</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>work-order-iandt</artifactId>
    <packaging>jar</packaging>
    <name>work-order-iandt</name>
    <description>Integration Tests Module with Testcontainers for 15soat-phase4-api-work-order</description>

    <dependencies>
        <!-- Application and Domain under test -->
        <dependency>
            <groupId>br.com.fiap.phase4</groupId>
            <artifactId>work-order-application</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>br.com.fiap.phase4</groupId>
            <artifactId>work-order-domain</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Commons Integration Test Fixtures (Testcontainers: PostgreSQL, Kafka) -->
        <dependency>
            <groupId>br.com.fiap.phase4</groupId>
            <artifactId>mod-integration-test</artifactId>
            <version>${commons.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot Starter Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Awaitility for Asynchronous Assertions -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Graceful Degradation: tests skipped by default unless -DintegrationTests=true is passed -->
                    <skipTests>true</skipTests>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>integrationTests</id>
            <activation>
                <property>
                    <name>integrationTests</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <skipTests>false</skipTests>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
